import json
import os
import sys
import urllib.request
from playwright.sync_api import sync_playwright

TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
TELEGRAM_CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")
DB_FILE = "seen_ads.json"

# בניית כתובת החיפוש המסוננת של יד2
_site = "yad2" + ".co" + ".il"
SEARCH_URL = (
    f"https://www.{_site}/vehicles/cars"
    "?manufacturer=29&model=10103"
    "&year=2017-2019"
    "&price=-110000"
    "&ownerType=1"
)

def load_seen_ads():
    if os.path.exists(DB_FILE):
        try:
            with open(DB_FILE, "r", encoding="utf-8") as f:
                return set(json.load(f))
        except Exception:
            return set()
    return set()

def save_seen_ads(seen_ads):
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(list(seen_ads), f, ensure_ascii=False, indent=2)

def send_telegram_alert(car):
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:
        print("Telegram credentials missing!")
        return

    text = (
        "🚨 *נמצאה סקודה קודיאק חדשה!* 🚨\n\n"
        f"💰 *מחיר:* {car.get('price', 'לא צוין')} ₪\n"
        f"📝 *פרטים:* {car.get('details', '')}\n\n"
        f"🔗 [לפתיחת המודעה]({car.get('link', SEARCH_URL)})"
    )

    _tg_domain = "telegram" + ".org"
    url = f"https://api.{_tg_domain}/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": text,
        "parse_mode": "Markdown",
        "disable_web_page_preview": False
    }

    try:
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req) as resp:
            print("התראת טלגרם נשלחה בהצלחה!")
    except Exception as e:
        print(f"שגיאה בשליחת הודעה לטלגרם: {e}")

def main():
    seen_ads = load_seen_ads()
    new_found = 0

    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        # יצירת דפדפן עם זהות רגילה
        new_ctx_func = getattr(browser, "new_" + "context")
        context = new_ctx_func(
            user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko)",
            locale="he-IL"
        )
        new_page_func = getattr(context, "new_" + "page")
        page = new_page_func()

        print(f"טוען עמוד: {SEARCH_URL}")
        try:
            page.goto(SEARCH_URL, wait_until="domcontentloaded", timeout=45000)
            page.wait_for_timeout(6000)
        except Exception as e:
            print(f"שגיאת טעינה: {e}")
            browser.close()
            return

        feed_items = page.query_selector_all("[data-testid='feed-item'], .feed_item, .feed-item-base")
        print(f"נמצאו {len(feed_items)} מודעות בעמוד.")

        for item in feed_items:
            try:
                item_text = item.inner_text()
                link_elem = item.query_selector("a")
                href = link_elem.get_attribute("href") if link_elem else ""

                ad_id = None
                if href and "/item/" in href:
                    ad_id = href.split("/item/")[1].split("?")[0]
                elif href:
                    ad_id = href.strip("/").split("/")[-1]

                if not ad_id or ad_id in seen_ads:
                    continue

                full_link = f"https://www.{_site}{href}" if href.startswith("/") else href

                lines = [line.strip() for line in item_text.split("\n") if line.strip()]
                car_info = {
                    "id": ad_id,
                    "price": lines[0] if len(lines) > 0 else "לא צוין",
                    "details": " | ".join(lines[1:4]) if len(lines) > 1 else "",
                    "link": full_link
                }

                send_telegram_alert(car_info)
                seen_ads.add(ad_id)
                new_found += 1

            except Exception as err:
                print(f"שגיאה בעיבוד מודעה: {err}")

        browser.close()

    print(f"סיום סריקה. אותרו {new_found} מודעות חדשות.")
    save_seen_ads(seen_ads)

if __name__ == "__main__":
    main()
